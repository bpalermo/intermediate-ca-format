load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_buf//buf:defs.bzl", "buf_lint_test")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# secret.pb.go is generated from secret.proto and COMMITTED, so that
# `go get github.com/bpalermo/intermediate-ca-format` works without Bazel, and
# this module builds from the committed file too (the go_library below).
# Gazelle therefore generates no proto rules here, only the go_library of the
# committed .go file; the proto_library, the generator and its checks are
# written by hand.
#
#   bazel run //intermediateca/v1:generate    regenerates secret.pb.go
#   bazel test //intermediateca/v1:generated_test   fails if it is stale
#
# gazelle:proto disable

proto_library(
    name = "secret_proto",
    srcs = ["secret.proto"],
    visibility = ["//visibility:public"],
    deps = ["@protovalidate//proto/protovalidate/buf/validate:validate_proto"],
)

# What generates secret.pb.go: protoc with protoc-gen-go, as rules_go runs them.
# Only the generated source is ever used, never this target's compiled Go.
go_proto_library(
    name = "secret_go_proto",
    importpath = "github.com/bpalermo/intermediate-ca-format/intermediateca/v1",
    proto = ":secret_proto",
    tags = ["manual"],
    deps = ["@build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate"],
)

filegroup(
    name = "generated",
    srcs = [":secret_go_proto"],
    output_group = "go_generated_srcs",
    tags = ["manual"],
)

sh_binary(
    name = "generate",
    srcs = ["generate.sh"],
    args = [
        "$(rootpath :generated)",
        "intermediateca/v1/secret.pb.go",
    ],
    data = [":generated"],
    tags = ["manual"],
)

sh_test(
    name = "generated_test",
    size = "small",
    srcs = ["generated_test.sh"],
    args = [
        "$(rootpath :generated)",
        "$(rootpath secret.pb.go)",
    ],
    data = [
        "secret.pb.go",
        ":generated",
    ],
)

buf_lint_test(
    name = "secret_proto_lint_test",
    size = "small",
    config = "//:buf.yaml",
    targets = [":secret_proto"],
)

go_library(
    name = "intermediateca",
    srcs = ["secret.pb.go"],
    importpath = "github.com/bpalermo/intermediate-ca-format/intermediateca/v1",
    visibility = ["//visibility:public"],
    deps = [
        "@build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate",
        "@org_golang_google_protobuf//reflect/protoreflect",
        "@org_golang_google_protobuf//runtime/protoimpl",
    ],
)
